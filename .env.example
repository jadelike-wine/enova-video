# ============================================================
# Agnes AI Creator - Docker 部署环境变量示例
# 复制为 .env 后按需填写：cp .env.example .env
# 所有值均为占位/默认，不含任何真实密钥。
# ============================================================

# ---- 必需 ----
# 站点对外访问的完整 URL（用于 SEO canonical / OpenGraph / sitemap）。
# 生产务必改为你的真实域名，例如 https://ai.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- 容器间通信（一般无需修改）----
# Next.js 服务端转发 /api/* 到后端。Docker Compose 内部使用服务名 backend。
BACKEND_URL=http://backend:8000

# ---- 可选：SQLite 数据库路径（容器内固定为 /data/app.db）----
# 通过 volume 持久化，无需修改，此处仅作说明
# DATABASE_PATH=/data/app.db

# ---- 可选：Agnes AI ----
# 数据库为空时，将用此 Key 作为初始 API Key 自动导入（也可在网页「设置」中手动添加）
AGNES_API_KEY=
# Agnes Base URL 初始值（默认 https://apihub.agnes-ai.com）
AGNES_BASE_URL=

# ---- 对象存储 ----
# 存储 Provider：none | qiniu | s3
STORAGE_PROVIDER=none

# ---- AWS S3（STORAGE_PROVIDER=s3 时使用）----
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
AWS_S3_PREFIX=agnes-ai
# 可选：CloudFront / 自定义 CDN 域名，配置后返回稳定公开 URL
AWS_S3_PUBLIC_BASE_URL=
# 可选：S3 兼容存储（MinIO/LocalStack）才需要，AWS S3 留空
AWS_S3_ENDPOINT_URL=
# 可选。生产环境优先使用 IAM Role（EC2/ECS/EKS），无需填写以下密钥
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ---- 可选：七牛云对象存储（STORAGE_PROVIDER=qiniu 时使用，不填则跳过转存，AI 生成仍可用）----
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=
QINIU_REGION=z0

# ---- 更新检查（仅后端使用，绝不注入 NEXT_PUBLIC_*）----
# GitHub 仓库（owner/repo），用于手动「检查更新」与 scripts/update.sh
GITHUB_REPOSITORY=jadelike-wine/enova-video
# 更新通道：stable（默认，忽略 draft / prerelease）
UPDATE_CHANNEL=stable
# 只读 GitHub Token（public 仓库可留空；private 仓库需最小权限 read packages/releases）
# 仅后端使用，禁止暴露到前端，禁止写入日志
GITHUB_TOKEN=

# ---- 更新脚本（服务器端）----
# 保留最近 N 份 SQLite 备份（默认 5）
UPDATE_BACKUP_KEEP=5
# 更新后健康检查次数与间隔（秒）
UPDATE_HEALTH_ATTEMPTS=30
UPDATE_HEALTH_INTERVAL=2
# 前端外部访问地址（宿主机上容器 3000 端口映射），健康检查用
FRONTEND_URL=http://localhost:3000

# ---- 日志 ----
# 日志等级：DEBUG | INFO | WARNING | ERROR | CRITICAL（默认 INFO）
LOG_LEVEL=INFO
# 日志格式：text（人读） | json（接 CloudWatch/Loki/ELK）
LOG_FORMAT=text
# 是否把用户 prompt 写入日志（默认 false，避免敏感/超长内容刷进 Docker log）
LOG_PROMPTS=false
# 是否输出请求级 access 日志（含 request_id / method / path / status / duration）
ACCESS_LOG=true