  "info": {
    "title": "Enova Creator API",
    "description": "灵动创影 AI Creator SaaS 后端 API",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "health",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "turnstileToken": {
            "type": "string",
            "description": "Cloudflare Turnstile 验证码 token（启用时必填）"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string"
          },
          "turnstileToken": {
            "type": "string",
            "description": "Cloudflare Turnstile 验证码 token（启用时必填）"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CreateConversationDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "我的新对话"
          }
        }
      },
      "UpdateConversationDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "重命名对话"
          }
        },
        "required": [
          "title"
        ]
      },
      "CreateMessageDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "example": "user"
          },
          "content": {
            "type": "string",
            "example": "你好，生成一张图片"
          },
          "provider": {
            "type": "string",
            "example": "agnes"
          },
          "model": {
            "type": "string",
            "example": "model-x"
          }
        },
        "required": [
          "role",
          "content"
        ]
      },
      "SaveMessagesDto": {
        "type": "object",
        "properties": {
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateMessageDto"
            }
          }
        },
        "required": [
          "messages"
        ]
      },
      "CreateGenerationDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "IMAGE",
              "VIDEO",
              "AUDIO",
              "UPSCALE",
              "LIPSYNC",
              "IMAGE_TO_VIDEO",
              "VIDEO_TO_VIDEO"
            ],
            "example": "IMAGE"
          },
          "provider": {
            "type": "string",
            "example": "agnes"
          },
          "model": {
            "type": "string",
            "example": "model-image-1"
          },
          "input": {
            "type": "object"
          }
        },
        "required": [
          "type",
          "provider",
          "model"
        ]
      },
      "CreateProviderDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "agnes"
          },
          "name": {
            "type": "string",
            "example": "Agnes AI"
          },
          "baseUrl": {
            "type": "string",
            "example": "https://api.agnes.example.com"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "DISABLED"
            ]
          },
          "config": {
            "type": "object"
          }
        },
        "required": [
          "code",
          "name",
          "baseUrl"
        ]
      },
      "UpdateProviderDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Agnes AI"
          },
          "baseUrl": {
            "type": "string",
            "example": "https://api.agnes.example.com"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "DISABLED"
            ]
          },
          "config": {
            "type": "object"
          }
        }
      },
      "CreateCredentialDto": {
        "type": "object",
        "properties": {
          "secret": {
            "type": "string",
            "example": "sk-xxxx"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "COOLDOWN",
              "ERROR",
              "DISABLED"
            ]
          },
          "priority": {
            "type": "number",
            "example": 0
          },
          "weight": {
            "type": "number",
            "example": 1
          },
          "maxConcurrency": {
            "type": "number",
            "example": 1
          }
        },
        "required": [
          "secret"
        ]
      },
      "UpdateCredentialDto": {
        "type": "object",
        "properties": {
          "secret": {
            "type": "string",
            "example": "sk-xxxx"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "COOLDOWN",
              "ERROR",
              "DISABLED"
            ]
          },
          "priority": {
            "type": "number",
            "example": 0
          },
          "weight": {
            "type": "number",
            "example": 1
          },
          "maxConcurrency": {
            "type": "number",
            "example": 1
          },
          "clearBackoff": {
            "type": "boolean",
            "example": true,
            "description": "清除 cooldown/lastError，手动恢复"
          }
        }
      },
      "SetUserStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "DISABLED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "AdjustCreditsDto": {
        "type": "object",
        "properties": {
          "delta": {
            "type": "number",
            "example": 1000,
            "description": "正数增加，负数扣减"
          },
          "description": {
            "type": "string",
            "example": "补偿用户"
          }
        },
        "required": [
          "delta"
        ]
      },
      "UpdateSettingDto": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "example": "100",
            "description": "字符串形式的新值"
          }
        },
        "required": [
          "value"
        ]
      },
      "UpdateVersionDto": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "example": "1.2.1",
            "description": "目标版本（缺省为最新 stable）"
          }
        }
      },
      "RollbackVersionDto": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "example": "1.1.2",
            "description": "回退到指定版本；缺省回退到上一个版本"
          }
        }
      },
      "CreateRechargeDto": {
        "type": "object",
        "properties": {
          "amountCents": {
            "type": "number",
            "description": "充值金额（分，人民币），需不小于最小充值金额",
            "example": 1000,
            "minimum": 1
          }
        },
        "required": [
          "amountCents"
        ]
      }
    }
  }
}