# ============================================================
# 灵动创影（EnovaMotion）- 环境变量示例
# 复制为 .env 后按需填写：cp .env.example .env
# 所有值均为占位/默认，不含任何真实密钥。
# ============================================================
#
# 架构原则：
#   .env = 系统如何启动（bootstrap / infrastructure / root secret）
#   System Settings = 系统启动之后如何运行（管理员后台动态配置）
#
# 以下配置已迁移到管理员后台「系统设置」页面，无需在 .env 中配置：
#   - 站点 URL（general.siteUrl）
#   - 对象存储（S3 / 七牛）
#   - 支付（支付宝 / 微信）
#   - 计费（welcome credits）
#   - 认证（Turnstile）
#   - 任务/视频策略（轮询、超时、重试）
#   - 安全/SSRF
#   - 日志级别/格式
#   - SMTP、邮件模板 URL、客服邮箱、应用名称
#   - 限流开关和 Redis key 前缀
#
# 首次启动时，如果 .env 中仍存在这些 legacy 变量，系统会自动将它们
# 迁移到数据库（幂等，不覆盖已有的 DB 配置）。迁移后可在后台修改。
# ============================================================

# ---- 必需：基础设施 ----
# 运行环境：development | test | production
NODE_ENV=development

# API 监听端口
PORT=3001
HOST=0.0.0.0

# PostgreSQL（与 docker-compose.dev.yml 一致）
DATABASE_URL=postgresql://enova:enova@localhost:5432/enova

# Redis / BullMQ
# 生产环境必须包含密码：redis://:password@host:6379
REDIS_URL=redis://localhost:6379
BULLMQ_PREFIX=enova

# ---- 必需：安全密钥 ----
# 生产环境必须替换为真实密钥，禁止使用下面的 dev 占位值。
# CREDENTIAL_MASTER_KEY：AES-256-GCM 加密 Provider Secret 和 System Settings 中
#   敏感配置的 32 字节 Master Key（hex 或 base64）。
#   生成：openssl rand -hex 32
#   严禁存入数据库或管理员后台。
CREDENTIAL_MASTER_KEY=dev-master-key-not-for-production

# ---- P0: CORS / 安全 ----
# 逗号分隔的允许源列表。生产必须设置为实际域名。
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Swagger 文档是否启用（生产建议关闭）
SWAGGER_ENABLED=false

# ---- 必需：版本（Docker build 时注入）----
APP_VERSION=0.0.0-development

# ---- 前端（Next.js，build-time / 容器间通信）----
# 站点对外访问的完整 URL（用于 SEO canonical / OpenGraph / sitemap）
# 此变量已迁移到管理员后台「系统设置」→「通用」→「站点 URL」中管理。
# 此处仅作为构建时 fallback（SSG/SSR 时如果 API 不可用则使用此值）。
# 管理员可在后台修改后立即生效，无需重新构建或部署。
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Next.js 服务端转发 /api/* 到后端。Docker Compose 内部使用服务名 api。
BACKEND_URL=http://api:3001

# ---- 可选：后台一键更新/回滚（默认关闭）----
# 是否启用后台更新/回滚。开启需在 docker-compose.prod.yml 挂载 docker.sock + 仓库目录。
UPDATE_ENABLED=false
# GitHub 仓库（owner/repo），用于检查更新与回滚版本列表
UPDATE_GITHUB_REPOSITORY=jadelike-wine/enova-video
# 私有仓库只读 token（可选），严禁写入日志
UPDATE_GITHUB_TOKEN=
# 更新检查结果缓存 TTL（毫秒）
UPDATE_CHECK_CACHE_TTL_MS=1200000
# 更新检查请求超时（毫秒）
UPDATE_CHECK_TIMEOUT_MS=8000
# 执行更新/回滚的超时（毫秒），客户端断开后仍继续
UPDATE_EXEC_TIMEOUT_MS=900000
# API 容器内 Docker Socket 路径
UPDATE_DOCKER_SOCKET=/var/run/docker.sock
# 触发脚本的 deploy-tool 镜像（需含 docker CLI + compose + bash + curl + python3）
UPDATE_DEPLOY_TOOL_IMAGE=ghcr.io/jadelike-wine/enova-video-deploy-tool:latest
# 仓库在 api 容器内的挂载路径（需与 docker-compose 卷映射一致）
UPDATE_REPO_MOUNT=/host/repo
# 仓库内 scripts 目录相对路径
UPDATE_SCRIPTS_SUBDIR=scripts
# 回滚版本列表最多暴露当前版本之前的 N 个稳定版本
UPDATE_MAX_ROLLBACK_VERSIONS=3
