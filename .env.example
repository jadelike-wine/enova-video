# BULLMQ_JOB_ATTEMPTS=5
# BULLMQ_JOB_BACKOFF_MS=5000
# VIDEO_POLL_INTERVAL_MS=15000
# VIDEO_MAX_POLLS=240
# VIDEO_MAX_WAIT_MS=1800000
# CREDENTIAL_RETRY_ATTEMPTS=3
# CREDENTIAL_LEASE_TTL_MS=120000
# PROVIDER_HTTP_TIMEOUT_MS=120000
# STORAGE_MAX_BYTES=536870912
# STORAGE_DOWNLOAD_TIMEOUT_MS=120000
