# ---- 对象存储（可选）----
# 存储 Provider：none | qiniu | s3
STORAGE_PROVIDER=none

# ---- AWS S3（STORAGE_PROVIDER=s3 时使用）----
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
AWS_S3_PREFIX=agnes-ai
# 可选：CloudFront / 自定义 CDN 域名，配置后返回稳定公开 URL
AWS_S3_PUBLIC_BASE_URL=
# 可选：S3 兼容存储（MinIO/LocalStack）才需要，AWS S3 留空
AWS_S3_ENDPOINT_URL=
# 可选。生产环境优先使用 IAM Role（EC2/ECS/EKS），无需填写以下密钥
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ---- 七牛云（STORAGE_PROVIDER=qiniu 时使用）----
QINIU_ACCESS_KEY=your_access_key
QINIU_SECRET_KEY=your_secret_key
QINIU_BUCKET=your_bucket_name
QINIU_DOMAIN=https://your-cdn-domain.example.com
QINIU_REGION=z0

DATABASE_PATH=./database/aimodel.db

# ---- 日志 ----
# 日志等级：DEBUG | INFO | WARNING | ERROR | CRITICAL（默认 INFO）
LOG_LEVEL=INFO
# 日志格式：text（人读） | json（接 CloudWatch/Loki/ELK）
LOG_FORMAT=text
# 是否把用户 prompt 写入日志（默认 false，避免敏感/超长内容刷进 Docker log）
LOG_PROMPTS=false
# 是否输出请求级 access 日志（含 request_id / method / path / status / duration）
ACCESS_LOG=true