{
  "name": "@enova/migrator",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "migrate:sqlite": "node dist/cli.js"
  },
  "dependencies": {
    "@enova/contracts": "workspace:*",
    "@enova/db": "workspace:*",
    "drizzle-orm": "^0.36.4"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "eslint": "^9.13.0",
    "vitest": "^2.1.4",
    "@types/node": "^20.16.0"
  }
}