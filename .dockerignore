# =============================================================================
# 新架构根级 .dockerignore（构建上下文 = 仓库根）
# =============================================================================

# 依赖与构建产物（构建阶段内重新生成）
node_modules
**/node_modules
**/dist
**/.next
**/build

# 本地环境
.env
.env.*
!.env.example

# 版本控制
.git
.gitignore

# 旧架构（新架构镜像不包含）
backend
frontend

# 备份 / 数据库 / 临时文件
backups
*.db
*.db-wal
*.db-shm
.deploy

# 日志与缓存
logs
*.log
.DS_Store
.cache